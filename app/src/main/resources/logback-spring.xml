<?xml version="1.0" encoding="UTF-8"?>
<!-- Human-readable logs locally; one JSON object per line in the cloud and job profiles.
     The correlation ID (MDC key "correlationId") is in both formats; JSON includes all MDC entries. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="cloud,job">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"briefwise"}</customFields>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!cloud &amp; !job">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{correlationId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
