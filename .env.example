# Copy to .env (git-ignored) for docker compose and the `local` profile. Never commit real secrets.
# Local-only throwaway password for the Docker Compose Postgres:
POSTGRES_PASSWORD=briefwise

# Finnhub company news (free key from https://finnhub.io/register; personal use only). The app does not read this
# file: set FINNHUB_API_KEY in the shell that starts it. CI and jobs get it from GitHub Secrets.
FINNHUB_API_KEY=

# Claude API (cloud / job profiles, evals). Locally the `ollama` provider needs no key. Never commit a real key.
ANTHROPIC_API_KEY=

# `cloud` / `job` profiles read these from GitHub Secrets or your shell, not from this file:
#   NEON_JDBC_URL, NEON_DB_USER, NEON_DB_PASSWORD
